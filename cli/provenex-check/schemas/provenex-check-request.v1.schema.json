{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.provenex.ai/provenex-check-request.v1.schema.json",
  "title": "Provenex Check request v1",
  "type": "object",
  "x-maxAggregateContentBytes": 67108864,
  "$comment": "The UTF-8 byte sum of every source_files[].content and artifacts[].content value must not exceed 67108864 bytes.",
  "additionalProperties": false,
  "required": ["schema_version", "command", "target", "consent", "source_files", "artifacts"],
  "allOf": [
    {
      "if": {
        "properties": { "requested_report_schema": { "const": "provenex-check-public-report.v2" } },
        "required": ["requested_report_schema"]
      },
      "then": { "required": ["project_scope"] }
    },
    {
      "if": {
        "properties": { "command": { "const": "scan" } },
        "required": ["command"]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "properties": {
                "kind": { "enum": ["session", "conversation_export", "dependency_audit", "telemetry"] }
              }
            }
          }
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "properties": { "kind": { "const": "aws_cost" } },
            "required": ["kind"]
          },
          "minContains": 0,
          "maxContains": 32
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "properties": { "kind": { "const": "dependency_audit" } },
            "required": ["kind"]
          },
          "minContains": 0,
          "maxContains": 32
        }
      }
    },
    {
      "properties": {
        "artifacts": {
          "contains": {
            "properties": { "kind": { "const": "telemetry" } },
            "required": ["kind"]
          },
          "minContains": 0,
          "maxContains": 32
        }
      }
    }
  ],
  "properties": {
    "schema_version": { "const": "provenex-check-request.v1" },
    "requested_report_schema": {
      "enum": ["provenex-check-public-report.v1", "provenex-check-public-report.v2"],
      "default": "provenex-check-public-report.v1",
      "description": "Optional response negotiation. Omission preserves the strict v1 public report; updated clients request v2 explicitly and must supply project_scope."
    },
    "project_scope": {
      "type": "string",
      "pattern": "^pvxproj-[0-9a-f]{64}$",
      "description": "Opaque client-authored HMAC project identity used to bind local comparisons. It is required for public-report.v2, is signed and echoed for self-consistency, and is not Provenex authority or tenant identity."
    },
    "command": { "enum": ["scan", "audit"] },
    "target": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\s)(?!.*\\s$)[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Zl}\\p{Zp}]+$", "x-maxUtf8Bytes": 255, "description": "Sanitized display-only basename, bounded to 255 UTF-8 bytes; never an absolute local path." },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved", "categories", "policy_id"],
      "properties": {
        "approved": { "const": true },
        "policy_id": { "const": "provenex-check-ephemeral-v1" },
        "categories": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ai_session_history",
              "cloud_cost_and_usage",
              "cloud_logs",
              "configuration",
              "dependency_audit",
              "environment_secrets",
              "platform_logs",
              "runtime_telemetry",
              "source_code"
            ]
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "content", "git_state"],
        "properties": {
          "relative_path": { "type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)(?:\\.git|\\.hg|\\.svn)(?:/|$))(?!.*[\\u0000-\\u001F\\u007F])(?!.*/$).+$", "x-maxUtf8Bytes": 4096, "description": "Normalized repository-relative path bounded to 4096 UTF-8 bytes." },
          "content": { "type": "string", "maxLength": 4194304, "x-maxUtf8Bytes": 4194304 },
          "git_state": { "enum": ["tracked", "untracked", "ignored", "unknown"] }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "content"],
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "session" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^session-[0-9]{3}\\.jsonl$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "conversation_export" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^conversation-export-[0-9]{3}\\.json$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "fly_log" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^fly-log-[0-9]{3}\\.jsonl$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "cloudwatch_log" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^cloudwatch-log-[0-9]{3}\\.json$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "aws_cost" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^aws-cost-[0-9]{3}\\.json$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "dependency_audit" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^dependency-audit-[0-9]{3}\\.json$" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "telemetry" } }, "required": ["kind"] },
            "then": { "properties": { "name": { "pattern": "^telemetry-[0-9]{3}\\.json$" } } }
          }
        ],
        "properties": {
          "kind": { "enum": ["session", "conversation_export", "fly_log", "cloudwatch_log", "aws_cost", "dependency_audit", "telemetry"] },
          "name": { "type": "string", "maxLength": 255, "pattern": "^[a-z]+(?:-[a-z]+)*-[0-9]{3}\\.jsonl?$", "x-maxUtf8Bytes": 255, "description": "Opaque deterministic kind-specific label generated by the CLI; never a local filename or path." },
          "content": { "type": "string", "maxLength": 67108864, "x-maxUtf8Bytes": 67108864 },
          "format": {
            "type": "string",
            "enum": [
              "otel", "otlp", "otel-genai", "langfuse", "langsmith", "langchain",
              "chatgpt", "openai", "okta", "bedrock", "aws",
              "m365", "copilot", "m365-copilot", "anthropic", "anthropic-compliance",
              "gws", "google", "google-workspace", "github", "salesforce", "sfdc", "mcp",
              "shopify", "data-activity", "data_activity", "slack", "slack-audit",
              "slack-enterprise"
            ]
          }
        }
      }
    }
  }
}
